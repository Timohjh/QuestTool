<Application x:Class="QuestTool.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#18222F"/>
    <SolidColorBrush x:Key="Muted" Color="#A6B5C8"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF3F9"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2D4057"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#101925"/><Setter Property="Foreground" Value="#EEF3F9"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#394D64"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEF3F9"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#101925"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#A6B5C8"/><Setter Property="Background" Value="#18222F"/><Setter Property="Padding" Value="22,12"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabBody" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}"><TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#26483F"/><Setter Property="Foreground" Value="#A4F0D5"/></Trigger><Trigger SourceName="TabBody" Property="IsMouseOver" Value="True"><Setter TargetName="TabBody" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#223145"/><Setter Property="Foreground" Value="#A6B5C8"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="#18222F"/><Setter Property="Foreground" Value="#EEF3F9"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#29415A"/></Trigger></Style.Triggers></Style>
  </Application.Resources>
</Application>
